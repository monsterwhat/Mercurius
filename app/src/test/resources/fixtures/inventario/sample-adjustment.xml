<?xml version="1.0" encoding="UTF-8"?>
<!--
  T35 fixture: valid v4.4-shaped factura electronica used by
  Controllers.Api.App.InventarioResourceTest to drive the upload endpoint
  end-to-end (POST /api/app/inventario/upload -> Utils.Parsers.Parser).

  Provenance (.omo/evidence/t35/fixture-provenance.md): every element below
  maps to a node read by Parser.parseXML / its helpers — root element name
  via mapRootElementToDocumentCode ("FacturaElectronica" -> "01"), Clave and
  NumeroConsecutivo via extractNumeroConsecutivo, FechaEmision via
  parseFechaEmision ("yyyy-MM-dd'T'HH:mm:ss" is its first formatter),
  Emisor/Receptor via parseEmisor/parseReceptor (Nombre +
  Identificacion/Tipo+Numero), MedioPago code "01" via
  Tipo_MedioPago.fromCodigo, ResumenFactura via parseResumenFactura
  (CodigoTipoMoneda/CodigoMoneda + TipoCambio are MANDATORY - empty values
  abort with "error en resumen de factura"), and DetalleServicio/
  LineaDetalle via parseLineaDetalle where Cantidad, PrecioUnitario,
  MontoTotal, SubTotal and MontoTotalLinea MUST be numeric non-empty
  strings. No xmlns attributes on purpose: Jackson XmlMapper reads local
  names and the parser performs no schema validation; ComprobanteFactory.
  detectVersion failures are tolerated upstream (warning only).
-->
